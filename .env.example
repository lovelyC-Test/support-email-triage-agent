# Copy to .env and fill in. Never commit .env.

# --- LLM provider ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Retrieval ---
VECTOR_STORE_URL=
EMBEDDING_MODEL=
HELP_DOCS_PATH=data/help_docs

# --- Confidence gate ---
# Threshold below which an answer is escalated to a human instead of sent.
CONFIDENCE_THRESHOLD=

# --- Human handover ---
ESCALATION_INBOX=

# --- App ---
LOG_LEVEL=INFO
