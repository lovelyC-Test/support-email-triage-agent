# Copy to .env and fill in. Never commit .env - it is gitignored, and gitleaks
# runs in pre-commit as a second line of defence.
#
# Only secrets belong in here. Everything else is in config/settings.yaml, which
# IS committed, so that thresholds have a visible history in git.

# The model provider API key. Not needed until phase 6: everything before that
# runs against FakeGateway, offline and free.
OPENAI_API_KEY=
